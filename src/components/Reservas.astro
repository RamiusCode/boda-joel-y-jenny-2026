---
// NumeroPases.astro
// Este componente muestra el número de pases asignados a cada invitado
// Se puede configurar dinámicamente según el invitado

interface Props {
    numeroPases: number; // 1, 2, 3, etc.
    nombreInvitado?: string; // Opcional: "Juan Pérez", "Familia García", etc.
}

const { numeroPases = 1, nombreInvitado = "" } = Astro.props;
---

<section class="relative w-full py-4 px-6 overflow-hidden">
    <!-- Partículas flotantes de fondo -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div
            class="particula-dorada"
            style="left: 10%; top: 20%; animation-delay: 0s;"
        >
        </div>
        <div
            class="particula-dorada"
            style="left: 85%; top: 30%; animation-delay: 1.5s;"
        >
        </div>
        <div
            class="particula-dorada"
            style="left: 15%; top: 70%; animation-delay: 3s;"
        >
        </div>
        <div
            class="particula-dorada"
            style="left: 90%; top: 65%; animation-delay: 2s;"
        >
        </div>
    </div>

    <div
        class="max-w-sm lg:max-w-3xl mx-auto relative z-10"
        id="contenedor-pases"
    >
        <!-- MARCO PRINCIPAL CON EFECTO GLASSMORPHISM -->
        <div
            class="backdrop-blur-sm rounded-3xl border-2 border-[#1F1F1F]/25 p-8 shadow-sm relative overflow-hidden"
        >
            <!-- Brillo sutil animado en la esquina -->
            <div
                class="absolute -top-20 -right-20 w-40 h-40 bg-gradient-to-br from-[#1F1F1F]/10 to-transparent rounded-full blur-3xl animate-pulse-slow"
            >
            </div>
            <div
                class="absolute -bottom-20 -left-20 w-40 h-40 bg-gradient-to-tr from-[#1F1F1F]/8 to-transparent rounded-full blur-3xl animate-pulse-slow"
                style="animation-delay: 1s;"
            >
            </div>

            <!-- CONTENIDO -->
            <div class="text-center relative" id="tarjeta-pases">
                <!-- Icono de ticket/pase -->
                <div class="flex justify-center mb-6">
                    <div class="w-16 h-16 relative pase-icon-container">
                        <div
                            class="absolute inset-0 bg-gradient-to-br from-[#8C1D2F]/20 to-[#8C1D2F]/5 rounded-full blur-xl animate-pulse-slow"
                        >
                        </div>
                        <img
                            src="/iconos/reserva.png"
                            alt="Icono de reserva"
                            class="w-full h-full object-contain relative z-10 transform transition-transform duration-300 hover:scale-110 verde-filter"
                        />
                    </div>
                </div>

                <!-- Título principal -->
                <h3
                    class="text-[#8C1D2F] tracking-[0.3em] uppercase text-lg md:text-2xl mb-3 relative inline-block"
                >
                    Pases Asignados
                </h3>

                <!-- Línea decorativa -->
                <div class="flex items-center justify-center gap-2 mb-2">
                    <div
                        class="w-12 h-px bg-gradient-to-r from-transparent to-[#1F1F1F]/30"
                    >
                    </div>
                    <div class="w-2 h-2 rounded-full bg-[#1F1F1F]/40"></div>
                    <div
                        class="w-12 h-px bg-gradient-to-l from-transparent to-[#1F1F1F]/30"
                    >
                    </div>
                </div>

                <!-- Nombre del invitado (si se proporciona) -->
                {
                    nombreInvitado && (
                        <p class="font-charm text-[#1F1F1F] text-xl md:text-2xl mb-6">
                            {nombreInvitado}
                        </p>
                    )
                }

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- CARD DEL NÚMERO DE PASES - DISEÑO MEJORADO Y DESTACADO -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <div class="relative mb-6" id="card-numero-pases">
                    <!-- Card principal con glassmorphism y sombras elegantes -->
                    <div>
                        <!-- CONTENIDO DEL CARD -->
                        <div class="relative z-10">
                            <!-- Número grande y destacado -->
                            <div class="mb-3">
                                <p
                                    class="text-[#8C1D2F] text-5xl md:text-5xl font-bold leading-none numero-pases"
                                    style="text-shadow: 0 4px 12px rgba(140, 29, 47, 0.2);"
                                >
                                    {numeroPases}
                                </p>
                            </div>

                            <!-- Texto descriptivo debajo del número -->
                            <div class="space-y-1">
                                <p
                                    class="text-[#8C1D2F] tracking-[0.25em] uppercase text-base md:text-xl font-semibold"
                                >
                                    {numeroPases === 1 ? "Pase" : "Pases"}
                                </p>
                                <div
                                    class="flex items-center justify-center gap-2 mt-2"
                                >
                                    <div class="w-8 h-px bg-[#8C1D2F]/30"></div>
                                    <div
                                        class="w-1.5 h-1.5 rounded-full bg-[#8C1D2F]/50"
                                    >
                                    </div>
                                    <div class="w-8 h-px bg-[#8C1D2F]/30"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sombra proyectada suave -->
                    <div
                        class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-[90%] h-4 bg-[#8C1D2F]/10 rounded-full blur-xl"
                    >
                    </div>
                </div>

                <!-- Texto descriptivo -->
                <p
                    class="font-charm text-[#1F1F1F] text-lg md:text-2xl lg:text-3xl leading-relaxed mb-6"
                >
                    {
                        numeroPases === 1
                            ? "Tu asistencia es invaluable para nosotros"
                            : "Esperamos contar con su presencia"
                    }
                </p>

                <!-- Nota amable sobre los pases -->
                <!-- <div class="mt-4 mb-2 px-4 py-3 rounded-2xl border border-[#8C1D2F]/20 bg-[#8C1D2F]/5">
                    <p class="text-[#1F1F1F]/70 text-sm md:text-base leading-relaxed italic">
                        Por favor respeta el número de pases indicado. ¡Mil gracias! 🤍
                    </p>
                </div> -->

                <!-- Iconos decorativos de personas -->
                <div class="flex justify-center gap-3 mt-6">
                    {
                        Array.from({ length: numeroPases }).map((_, index) => (
                            <div
                                class="w-9 h-9 rounded-full bg-gradient-to-br from-[#1F1F1F]/15 to-[#8C1D2F]/10 flex items-center justify-center person-icon border border-[#8C1D2F]/20"
                                style={`animation-delay: ${index * 0.2}s;`}
                            >
                                <svg
                                    class="w-5 h-5 text-[#8C1D2F]"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                </svg>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════════════════════════════════════════════════════ -->
    <!-- 🌸 FLORES Y HOJAS DECORATIVAS - ENCIMA DEL CARD               -->
    <!-- ═════════════════════════════════════════════════════════════ -->

    <!-- LADO IZQUIERDO -->
    <div
        id="hoja-pases-left"
        class="absolute top-8 md:top-24 opacity-0 pointer-events-none z-40 -left-6 w-20 md:w-28"
    >
        <img
            src="/imagenes/hojadorada.png"
            alt="hoja dorada"
            class="block w-full h-auto"
        />
    </div>

    <div
        id="flor-pases-left"
        class="absolute top-12 md:top-24 opacity-0 pointer-events-none z-50 -left-8 w-20 md:w-28"
    >
        <img
            src="/imagenes/florlateral.png"
            alt="flor"
            class="block w-full h-auto"
        />
    </div>

    <!-- LADO DERECHO -->
    <div
        id="hoja-pases-right"
        class="absolute top-8 md:top-24 opacity-0 pointer-events-none z-40 -right-6 w-20 md:w-28"
    >
        <img
            src="/imagenes/hojadorada.png"
            alt="hoja dorada"
            class="block w-full h-auto scale-x-[-1]"
        />
    </div>

    <div
        id="flor-pases-right"
        class="absolute top-12 md:top-24 opacity-0 pointer-events-none z-50 -right-8 w-20 md:w-28"
    >
        <img
            src="/imagenes/florlateral.png"
            alt="flor"
            class="block w-full h-auto scale-x-[-1]"
        />
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS PERSONALIZADOS                                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* Partículas flotantes doradas */
    .particula-dorada {
        position: absolute;
        width: 4px;
        height: 4px;
        background: radial-gradient(circle, #8C1D2F 0%, transparent 70%);
        border-radius: 50%;
        animation: flotar 6s ease-in-out infinite;
        opacity: 0.4;
    }

    @keyframes flotar {
        0%,
        100% {
            transform: translateY(0) translateX(0);
            opacity: 0.2;
        }
        50% {
            transform: translateY(-30px) translateX(15px);
            opacity: 0.6;
        }
    }

    /* Animación de pulso lento */
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(1);
        }
        50% {
            opacity: 0.6;
            transform: scale(1.05);
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 4s ease-in-out infinite;
    }

    /* Animación suave del icono de pase */
    .pase-icon-container:hover svg {
        animation: bounce-gentle 0.6s ease;
    }

    @keyframes bounce-gentle {
        0%,
        100% {
            transform: translateY(0) scale(1);
        }
        50% {
            transform: translateY(-8px) scale(1.05);
        }
    }

    /* Animación de brillo */
    @keyframes shine {
        0% {
            transform: translateX(-100%) translateY(-100%) rotate(30deg);
            opacity: 0;
        }
        50% {
            opacity: 0.3;
        }
        100% {
            transform: translateX(100%) translateY(100%) rotate(30deg);
            opacity: 0;
        }
    }

    .animate-shine {
        animation: shine 3s ease-in-out infinite;
    }

    /* Animación de los iconos de personas */
    .person-icon {
        animation: pop-in 0.5s ease-out forwards;
        opacity: 0;
        transform: scale(0);
    }

    @keyframes pop-in {
        0% {
            opacity: 0;
            transform: scale(0);
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Animación especial para el número de pases */
    .numero-pases {
        animation: numero-appear 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        transform-origin: center;
    }

    @keyframes numero-appear {
        0% {
            transform: scale(0) rotate(-10deg);
            opacity: 0;
        }
        60% {
            transform: scale(1.1) rotate(5deg);
        }
        100% {
            transform: scale(1) rotate(0deg);
            opacity: 1;
        }
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initPases = () => {
        console.log("🎫 Iniciando sección de pases...");

        // ═══ ESTADO INICIAL ═══
        gsap.set("#contenedor-pases", {
            opacity: 0,
            y: 50,
            scale: 0.95,
        });

        gsap.set("#card-numero-pases", {
            opacity: 0,
            scale: 0.9,
            y: 20,
        });

        // Flores laterales - Estado inicial
        gsap.set("#flor-pases-left", {
            opacity: 0,
            x: -40,
            rotation: -8,
            scale: 0.9,
                    transformOrigin: "left center",
});

        gsap.set("#flor-pases-right", {
            opacity: 0,
            x: 40,
            rotation: 8,
            scale: 0.9,
                    transformOrigin: "right center",
});

        // Hojas doradas - Estado inicial
        gsap.set("#hoja-pases-left", {
            opacity: 0,
            scale: 0,
            rotation: -6,
            transformOrigin: "bottom center",
        });

        gsap.set("#hoja-pases-right", {
            opacity: 0,
            scaleX: 0,
            scaleY: 0,
            rotation: 6,
            transformOrigin: "bottom center",
        });

        gsap.set("#tarjeta-pases", { opacity: 0, y: 20 });

        // ═══ ANIMACIÓN PRINCIPAL ═══
        ScrollTrigger.create({
            trigger: "#contenedor-pases",
            start: "top 75%",
            end: "top 20%",

            onEnter: () => {
                const tl = gsap.timeline();

                // Card aparece
                tl.to(
                    "#contenedor-pases",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.6,
                        ease: "power3.out",
                    },
                    0,
                )

                    // Contenido del card principal
                    .to(
                        "#tarjeta-pases",
                        {
                            opacity: 1,
                            y: 0,
                            duration: 1,
                            ease: "power2.out",
                        },
                        0.4,
                    )

                    // Card del número con efecto especial
                    .to(
                        "#card-numero-pases",
                        {
                            opacity: 1,
                            scale: 1,
                            y: 0,
                            duration: 1.4,
                            ease: "back.out(1.4)",
                        },
                        0.8,
                    )

                    // 🌸 FLORES LATERALES - Entrada suave
                    .to(
                        "#flor-pases-left",
                        {
                            opacity: 0.75,
                            x: 0,
                            rotation: -3,
                            scale: 1,
                            duration: 2.8,
                            ease: "sine.out",
                        },
                        0,
                    )

                    .to(
                        "#flor-pases-right",
                        {
                            opacity: 0.75,
                            x: 0,
                            rotation: 3,
                            scale: 1,
                            duration: 2.8,
                            ease: "sine.out",
                        },
                        0.05,
                    )

                    // 🍃 HOJAS DORADAS - Crecimiento natural
                    .to(
                        "#hoja-pases-left",
                        {
                            opacity: 0.7,
                            scale: 0.9,
                            rotation: -3,
                            duration: 2.2,
                            ease: "sine.out",
                        },
                        0.1,
                    )

                    .to(
                        "#hoja-pases-right",
                        {
                            opacity: 0.7,
                            scale: 0.9,
                            rotation: 3,
                            duration: 2.2,
                            ease: "sine.out",
                        },
                        0.15,
                    );

                // ═══════════════════════════════════════════════════
                // 🍃 MOVIMIENTOS NATURALES CONTINUOS
                // ═══════════════════════════════════════════════════

                // Flor izquierda

                // ═══ HOJAS DORADAS: balanceo visible ═══
                gsap.to("#hoja-pases-left", {
                    y: -12,
                    rotation: -10,
                    duration: 4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3.5,
                });
                gsap.to("#hoja-pases-right", {
                    y: -11,
                    rotation: 10,
                    scale: 0.85,
                    duration: 4.3,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3.7,
                });
                gsap.to("#hoja-pases-left", {
                    scale: 0.85,
                    duration: 4.5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3.9,
                });

                // ═══ FLORES LATERALES: brisa natural ═══
                // Cada propiedad va en su propio tween con duraciones que no son
                // múltiplos entre sí (6.1 / 8.3 / 10.7 / 13.9): la combinación tarda
                // minutos en repetirse y se lee como movimiento vivo, no como bucle.
                // El giro parte del borde donde nace el ramo, no de su centro.
                const brisaNatural = (sel, dir, fase) => {
                    gsap.to(sel, {
                        rotation: 4 * dir,
                        duration: 6.1 + fase,
                        delay: 3.0 + fase * 0.6,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                    gsap.to(sel, {
                        y: -12,
                        duration: 8.3 + fase,
                        delay: 3.8 + fase * 0.5,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                    gsap.to(sel, {
                        x: 6 * dir,
                        duration: 10.7 + fase,
                        delay: 4.5 + fase * 0.4,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                    gsap.to(sel, {
                        scale: 1.05,
                        duration: 13.9 + fase,
                        delay: 5.2 + fase * 0.3,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                };

                brisaNatural("#flor-pases-left", -1, 0);
                brisaNatural("#flor-pases-right", 1, 0.9);
                // Flor derecha

                // Hoja izquierda

                // Hoja derecha

                // Respiración


                // Efecto brisa


                // Sutil movimiento del card del número
                gsap.to("#card-numero-pases", {
                    y: -5,
                    duration: 2.5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 2,
                });
            },

            onLeaveBack: () => {
                // Resetear todas las animaciones continuas
                gsap.killTweensOf("#flor-pases-left");
                gsap.killTweensOf("#flor-pases-right");
                gsap.killTweensOf("#hoja-pases-left");
                gsap.killTweensOf("#hoja-pases-right");
                gsap.killTweensOf("#card-numero-pases");

                const tl = gsap.timeline();

                tl.to("#tarjeta-pases", {
                    opacity: 0,
                    y: 20,
                    duration: 0.3,
                    ease: "power2.in",
                })

                    .to(
                        "#contenedor-pases",
                        {
                            opacity: 0,
                            y: 50,
                            scale: 0.95,
                            duration: 0.5,
                            ease: "power2.in",
                        },
                        "<",
                    )

                    .to(
                        "#flor-pases-left",
                        {
                            opacity: 0,
                            x: -40,
                            duration: 1,
                            ease: "sine.in",
                        },
                        "<",
                    )

                    .to(
                        "#flor-pases-right",
                        {
                            opacity: 0,
                            x: 40,
                            duration: 1,
                            ease: "sine.in",
                        },
                        "<",
                    )

                    .to(
                        "#hoja-pases-left, #hoja-pases-right",
                        {
                            opacity: 0,
                            scale: 0,
                            duration: 0.8,
                            ease: "sine.in",
                        },
                        "<",
                    )

                    .set("#flor-pases-left", {
                        rotation: -8,
                        scale: 0.9,
                        x: -40,
                        y: 0,
                    })
                    .set("#flor-pases-right", {
                        rotation: 8,
                        scale: 0.9,
                        x: 40,
                        y: 0,
                    })
                    .set("#hoja-pases-left", {
                        rotation: -6,
                        scale: 0,
                        y: 0,
                    })
                    .set("#hoja-pases-right", {
                        scaleX: 0,
                        scaleY: 0,
                        rotation: 6,
                        y: 0,
                    });
            },
        });

        console.log("🎫✨ Sección de pases activada!");
    };

    document.addEventListener("DOMContentLoaded", initPases);
    document.addEventListener("astro:page-load", initPases);
</script>
<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS PARA CONVERTIR IMÁGENES NEGRAS A DORADO          -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* Filtro que convierte imágenes PNG negras al color dorado #8C1D2F */
    .verde-filter {
        filter: brightness(0) saturate(100%) invert(18%) sepia(42%)
            saturate(525%) hue-rotate(115deg) brightness(78%) contrast(105%);
    }
</style>
