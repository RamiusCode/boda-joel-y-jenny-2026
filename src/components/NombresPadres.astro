---
// src/components/PadresPadrinos.astro - Con animaciones elegantes
---

<section class="w-full flex justify-center relative">
  <!-- ═══ HOJAS DORADAS ═══ -->
  <div
      id="hoja-dorada-familia-izq"
      class="absolute top-20 opacity-0 pointer-events-none z-10 -left-6 w-20 md:w-28"
  >
      <img
          src="/imagenes/hojadorada.png"
          alt=""
          class="block w-full h-auto"
      />
  </div>

  <div
      id="hoja-dorada-familia-der"
      class="absolute top-90 md:top-40 opacity-0 pointer-events-none z-10 -right-6 w-20 md:w-28"
  >
      <img
          src="/imagenes/hojadorada.png"
          alt=""
          class="block w-full h-auto scale-x-[-1]"
      />
  </div>

  <!-- ═══ FLORES LATERALES ═══ -->
  <div
      id="hoja-familia-izq"
      class="absolute top-20 opacity-0 pointer-events-none z-[11] -left-8 w-20 md:w-28"
  >
      <img
          src="/imagenes/florlateral.png"
          alt=""
          class="block w-full h-auto"
      />
  </div>

  <div
      id="hoja-familia-der"
      class="absolute top-90 md:top-40 opacity-0 pointer-events-none z-[11] -right-8 w-20 md:w-28"
  >
      <img
          src="/imagenes/florlateral.png"
          alt=""
          class="block w-full h-auto scale-x-[-1]"
      />
  </div>

  <div class="w-full max-w-5xl px-8 py-8 text-center" id="wrapper-familia">
    <!-- Grid de nombres de los padres y padrinos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">
      <!-- Padres del novio-->
      <div class="space-y-4 opacity-0" id="padres-novio">
        <h4
          class="text-[#8C1D2F] tracking-[0.2em] uppercase text-lg md:text-2xl lg:text-2xl xl:text-3xl font-semibold"
        >
          Padres del novio
        </h4>
        <div class="space-y-2">
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Francisco Limachi Callizaya
          </p>
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Marta Pongo de Limachi
          </p>
        </div>
      </div>

      <!-- Padres de la novia -->
      <div class="space-y-4 opacity-0" id="padres-novia">
        <h4
          class="text-[#8C1D2F] tracking-[0.2em] uppercase text-lg md:text-2xl lg:text-2xl xl:text-3xl font-semibold"
        >
          Padres de la Novia
        </h4>
        <div class="space-y-2">
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Eusebio Coro Suri (†)
          </p>
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Bertha Perez Mamani (†)
          </p>
        </div>
      </div>

      <!-- Consejeros matrimoniales -->
      <div class="space-y-4 opacity-0" id="padrinos-anillos">
        <h4
          class="text-[#8C1D2F] tracking-[0.2em] uppercase text-lg md:text-2xl lg:text-2xl xl:text-3xl font-semibold"
        >
          Consejeros matrimoniales
        </h4>
        <div class="space-y-2">
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Luis Hernán Carlo Mamani
          </p>
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Mady Chuquimia Quispe
          </p>
        </div>
      </div>

      <!-- Padrinos de torta -->
      <div class="space-y-4 opacity-0" id="padrinos-colitas">
        <h4
          class="text-[#8C1D2F] tracking-[0.2em] uppercase text-lg md:text-2xl lg:text-2xl xl:text-3xl font-semibold"
        >
          Padrinos de torta
        </h4>
        <div class="space-y-2">
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Jose Adolfo Quispe Chavez
          </p>
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Ruth Perez Marca
          </p>
        </div>
      </div>

      <!-- Padrino de filmación y fotografía - CENTRADO -->
      <!-- <div
        class="space-y-4 opacity-0 md:col-span-2 md:flex md:flex-col md:items-center"
        id="padrinos-filmacion"
      >
        <h4
          class="text-[#8C1D2F] tracking-[0.2em] uppercase text-lg md:text-2xl lg:text-2xl xl:text-3xl font-semibold"
        >
          Padrino de filmación y fotografía
        </h4>
        <div class="space-y-2">
          <p
            class="font-charm text-[#1F1F1F] text-xl md:text-3xl lg:text-3xl xl:text-4xl"
          >
            Julio César Choque Zegarra
          </p>
        </div>
      </div> -->
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initFamily = () => {
    console.log("👨‍👩‍👧‍👦 Iniciando animaciones de familia...");

    // 🎯 ESTADO INICIAL
    gsap.set("#padres-novio", { opacity: 0, x: -30, y: 15 });
    gsap.set("#padres-novia", { opacity: 0, x: 30, y: 15 });
    gsap.set("#padrinos-anillos", { opacity: 0, x: -30, y: 15 });
    gsap.set("#padrinos-colitas", { opacity: 0, x: 30, y: 15 });
    gsap.set("#padrinos-filmacion", { opacity: 0, y: 30 });

    // Flores laterales (ENCIMA)
    gsap.set("#hoja-familia-izq", {
      opacity: 0,
      x: -40,
      y: 20,
      rotation: -15,
      scale: 0.8,
        transformOrigin: "left center",
    });
    gsap.set("#hoja-familia-der", {
      opacity: 0,
      x: 40,
      y: 20,
      rotation: 15,
      scale: 0.8,
          transformOrigin: "right center",
});

    // Hojas doradas (ABAJO)
    gsap.set("#hoja-dorada-familia-izq", {
      opacity: 0,
      x: -50,
      y: 25,
      rotation: -20,
      scale: 0.7,
    });
    gsap.set("#hoja-dorada-familia-der", {
      opacity: 0,
      x: 50,
      y: 25,
      rotation: 20,
      scale: 0.7,
    });

    // ✨ ANIMACIÓN DE ENTRADA
    ScrollTrigger.create({
      trigger: "#wrapper-familia",
      start: "top bottom",
      end: "top 20%",

      onEnter: () => {
        const tl = gsap.timeline();

        // 1️⃣ Padres del novio - Desliza desde izquierda
        tl.to(
          "#padres-novio",
          {
            opacity: 1,
            x: 0,
            y: 0,
            duration: 1.2,
            ease: "power2.out",
          },
          0,
        )
          // 2️⃣ Padres de la novia - Desliza desde derecha
          .to(
            "#padres-novia",
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 1.2,
              ease: "power2.out",
            },
            0.3,
          )
          // 3️⃣ Padrinos de anillos - Desliza desde izquierda
          .to(
            "#padrinos-anillos",
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 1.2,
              ease: "power2.out",
            },
            0.6,
          )
          // 4️⃣ Padrinos de colitas - Desliza desde derecha
          .to(
            "#padrinos-colitas",
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 1.2,
              ease: "power2.out",
            },
            0.8,
          )
          // 5️⃣ Padrino filmación - Aparece desde abajo
          .to(
            "#padrinos-filmacion",
            {
              opacity: 1,
              y: 0,
              duration: 1.2,
              ease: "power2.out",
            },
            1.0,
          )
          // 4️⃣ FLORES LATERALES (ENCIMA) - Caída suave
          .to(
            "#hoja-familia-izq",
            {
              opacity: 0.8,
              x: 0,
              y: 0,
              rotation: 0,
              scale: 1,
              duration: 1.6,
              ease: "power1.out",
            },
            0.9,
          )
          .to(
            "#hoja-familia-der",
            {
              opacity: 0.8,
              x: 0,
              y: 0,
              rotation: 0,
              scale: 1,
              duration: 1.6,
              ease: "power1.out",
            },
            1.0,
          )
          // 5️⃣ HOJAS DORADAS (ABAJO) - Entrada elegante
          .to(
            "#hoja-dorada-familia-izq",
            {
              opacity: 0.9,
              x: 0,
              y: 0,
              rotation: 0,
              scale: 1,
              duration: 1.8,
              ease: "power1.out",
            },
            1.2,
          )
          .to(
            "#hoja-dorada-familia-der",
            {
              opacity: 0.9,
              x: 0,
              y: 0,
              rotation: 0,
              scale: 1,
              duration: 1.8,
              ease: "power1.out",
            },
            1.3,
          );

        // ═══════════════════════════════════════════════════
        // 🍃 MOVIMIENTOS NATURALES SUAVES
        // ═══════════════════════════════════════════════════

        // Flor lateral izquierda

        // ═══ HOJAS DORADAS: balanceo visible ═══
        gsap.to("#hoja-dorada-familia-izq", {
            y: -12,
            rotation: -10,
            duration: 4,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: 3.0,
        });
        gsap.to("#hoja-dorada-familia-der", {
            y: -11,
            rotation: 10,
            scale: 0.85,
            duration: 4.3,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: 3.2,
        });
        gsap.to("#hoja-dorada-familia-izq", {
            scale: 0.85,
            duration: 4.5,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: 3.4,
        });

        // ═══ FLORES LATERALES: brisa natural ═══
        // Cada propiedad va en su propio tween con duraciones que no son
        // múltiplos entre sí (6.1 / 8.3 / 10.7 / 13.9): la combinación tarda
        // minutos en repetirse y se lee como movimiento vivo, no como bucle.
        // El giro parte del borde donde nace el ramo, no de su centro.
        const brisaNatural = (sel, dir, fase) => {
            gsap.to(sel, {
                rotation: 4 * dir,
                duration: 6.1 + fase,
                delay: 2.5 + fase * 0.6,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
            });
            gsap.to(sel, {
                y: -12,
                duration: 8.3 + fase,
                delay: 3.3 + fase * 0.5,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
            });
            gsap.to(sel, {
                x: 6 * dir,
                duration: 10.7 + fase,
                delay: 4.0 + fase * 0.4,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
            });
            gsap.to(sel, {
                scale: 1.05,
                duration: 13.9 + fase,
                delay: 4.7 + fase * 0.3,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
            });
        };

        brisaNatural("#hoja-familia-izq", -1, 0);
        brisaNatural("#hoja-familia-der", 1, 0.9);
        // Flor lateral derecha

        // Hoja dorada izquierda

        // Hoja dorada derecha

        // ═══ RESPIRACIÓN SUTIL ═══


        // ═══ EFECTO BRISA ═══

      },

      onLeaveBack: () => {
        // Detener animaciones continuas
        gsap.killTweensOf("#hoja-familia-izq");
        gsap.killTweensOf("#hoja-familia-der");
        gsap.killTweensOf("#hoja-dorada-familia-izq");
        gsap.killTweensOf("#hoja-dorada-familia-der");

        const tl = gsap.timeline();

        tl.to(
          "#padres-novio, #padres-novia, #padrinos-anillos, #padrinos-colitas, #padrinos-filmacion, #hoja-familia-izq, #hoja-familia-der, #hoja-dorada-familia-izq, #hoja-dorada-familia-der",
          {
            opacity: 0,
            duration: 0.6,
            ease: "power2.in",
          },
        )
          .to(
            "#padres-novio",
            { x: -30, y: 15, duration: 0.6, ease: "power2.in" },
            "<",
          )
          .to(
            "#padres-novia",
            { x: 30, y: 15, duration: 0.6, ease: "power2.in" },
            "<",
          )
          .to(
            "#padrinos-anillos",
            { x: -30, y: 15, duration: 0.6, ease: "power2.in" },
            "<",
          )
          .to(
            "#padrinos-colitas",
            { x: 30, y: 15, duration: 0.6, ease: "power2.in" },
            "<",
          )
          .to(
            "#padrinos-filmacion",
            { y: 30, duration: 0.6, ease: "power2.in" },
            "<",
          )
          .to(
            "#hoja-familia-izq",
            {
              x: -40,
              y: 20,
              rotation: -15,
              scale: 0.8,
              duration: 0.6,
              ease: "power2.in",
            },
            "<",
          )
          .to(
            "#hoja-familia-der",
            {
              x: 40,
              y: 20,
              rotation: 15,
              scale: 0.8,
              duration: 0.6,
              ease: "power2.in",
            },
            "<",
          )
          .to(
            "#hoja-dorada-familia-izq",
            {
              x: -50,
              y: 25,
              rotation: -20,
              scale: 0.7,
              duration: 0.6,
              ease: "power2.in",
            },
            "<",
          )
          .to(
            "#hoja-dorada-familia-der",
            {
              x: 50,
              y: 25,
              rotation: 20,
              scale: 0.7,
              duration: 0.6,
              ease: "power2.in",
            },
            "<",
          );
      },
    });

    console.log("✨ Animaciones de familia listas!");
  };

  document.addEventListener("DOMContentLoaded", initFamily);
  document.addEventListener("astro:page-load", initFamily);
</script>
