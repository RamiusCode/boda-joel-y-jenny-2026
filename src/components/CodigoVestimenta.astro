---
// CodigoVestimenta.astro
---

<section class="relative w-full mt-16 md:mt-24 py-4 px-6 overflow-hidden">
    <!-- Partículas flotantes de fondo -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div
            class="particula-dorada"
            style="left: 10%; top: 20%; animation-delay: 0s;"
        >
        </div>
        <div
            class="particula-dorada"
            style="left: 85%; top: 30%; animation-delay: 1.5s;"
        >
        </div>
        <div
            class="particula-dorada"
            style="left: 15%; top: 70%; animation-delay: 3s;"
        >
        </div>
        <div
            class="particula-dorada"
            style="left: 90%; top: 65%; animation-delay: 2s;"
        >
        </div>
    </div>

    <div
        class="max-w-sm lg:max-w-3xl mx-auto relative z-10"
        id="contenedor-vestimenta"
    >
        <!-- MARCO PRINCIPAL CON EFECTO GLASSMORPHISM -->
        <div
            class="backdrop-blur-sm rounded-3xl border-2 border-[#1F1F1F]/25 p-8 shadow-sm relative overflow-hidden"
        >
            <!-- Brillo sutil animado en la esquina -->
            <div
                class="absolute -top-20 -right-20 w-40 h-40 bg-gradient-to-br from-[#1F1F1F]/10 to-transparent rounded-full blur-3xl animate-pulse-slow"
            >
            </div>
            <div
                class="absolute -bottom-20 -left-20 w-40 h-40 bg-gradient-to-tr from-[#1F1F1F]/8 to-transparent rounded-full blur-3xl animate-pulse-slow"
                style="animation-delay: 1s;"
            >
            </div>

            <!-- CONTENIDO -->
            <div class="text-center relative" id="tarjeta-vestimenta">
                <!-- Icono de vestimenta -->
                <div class="flex justify-center mb-6">
                    <div class="w-16 h-16 relative vestimenta-icon-container">
                        <div
                            class="absolute inset-0 bg-gradient-to-br from-[#8C1D2F]/20 to-[#8C1D2F]/5 rounded-full blur-xl animate-pulse-slow"
                        >
                        </div>

                        <img
                            src="/iconos/vestido-de-novia.png"
                            alt="Icono de vestimenta"
                            class="w-full h-full object-contain relative z-10 transform transition-transform duration-300 hover:scale-110 verde-filter"
                        />
                    </div>
                </div>

                <!-- Título principal -->
                <h3
                    class="text-[#8C1D2F] tracking-[0.3em] uppercase text-lg md:text-2xl mb-3 relative inline-block"
                >
                    Código de Vestimenta
                </h3>

                <!-- Línea decorativa -->
                <div class="flex items-center justify-center gap-2 mb-6">
                    <div
                        class="w-12 h-px bg-gradient-to-r from-transparent to-[#1F1F1F]/30"
                    >
                    </div>
                    <div class="w-2 h-2 rounded-full bg-[#1F1F1F]/40"></div>
                    <div
                        class="w-12 h-px bg-gradient-to-l from-transparent to-[#1F1F1F]/30"
                    >
                    </div>
                </div>

                <!-- FORMAL destacado -->
                <div
                    class="rounded-2xl py-4 px-6 mb-6 border border-[#1F1F1F]/10"
                >
                    <h4
                        class="text-[#1F1F1F] tracking-[0.25em] uppercase text-lg md:text-2xl"
                    >
                        Formal
                    </h4>
                </div>

                <!-- Texto descriptivo -->
                <!-- <p
                    class="font-charm text-[#1F1F1F] text-lg md:text-2xl lg:text-3xl leading-relaxed"
                >
                    Queremos que disfrutes de esta celebración de gala
                </p> -->
            </div>
        </div>
    </div>

    <!-- ═════════════════════════════════════════════════════════════ -->
    <!-- 🌸 HOJAS Y FLORES CON MOVIMIENTO NATURAL - ENCIMA DEL CARD   -->
    <!-- ═════════════════════════════════════════════════════════════ -->

    <!-- Hoja dorada izquierda (CAPA INFERIOR) -->
    <div
        id="hoja-vestimenta-left"
        class="absolute top-8 md:top-24 opacity-0 pointer-events-none z-20 -left-6 w-20 md:w-28"
    >
        <img
            src="/imagenes/hojadorada.png"
            alt="hoja dorada"
            class="block w-full h-auto"
        />
    </div>

    <!-- Hoja dorada derecha (CAPA INFERIOR) -->
    <div
        id="hoja-vestimenta-right"
        class="absolute top-8 md:top-24 opacity-0 pointer-events-none z-20 -right-6 w-20 md:w-28"
    >
        <img
            src="/imagenes/hojadorada.png"
            alt="hoja dorada"
            class="block w-full h-auto scale-x-[-1]"
        />
    </div>

    <!-- Flor lateral izquierda (CAPA SUPERIOR) -->
    <div
        id="flor-vestimenta-left"
        class="absolute top-12 md:top-24 opacity-0 pointer-events-none z-30 -left-8 w-20 md:w-28"
    >
        <img
            src="/imagenes/florlateral.png"
            alt="hojas"
            class="block w-full h-auto"
        />
    </div>

    <!-- Flor lateral derecha (CAPA SUPERIOR) -->
    <div
        id="flor-vestimenta-right"
        class="absolute top-12 md:top-24 opacity-0 pointer-events-none z-30 -right-8 w-20 md:w-28"
    >
        <img
            src="/imagenes/florlateral.png"
            alt="hojas"
            class="block w-full h-auto scale-x-[-1]"
        />
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS PERSONALIZADOS                                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* Partículas flotantes doradas */
    .particula-dorada {
        position: absolute;
        width: 4px;
        height: 4px;
        background: radial-gradient(circle, #8C1D2F 0%, transparent 70%);
        border-radius: 50%;
        animation: flotar 6s ease-in-out infinite;
        opacity: 0.4;
    }

    @keyframes flotar {
        0%,
        100% {
            transform: translateY(0) translateX(0);
            opacity: 0.2;
        }
        50% {
            transform: translateY(-30px) translateX(15px);
            opacity: 0.6;
        }
    }

    /* Animación de pulso lento */
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(1);
        }
        50% {
            opacity: 0.6;
            transform: scale(1.05);
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 4s ease-in-out infinite;
    }

    /* Animación suave del icono de vestimenta */
    .vestimenta-icon-container:hover svg {
        animation: bounce-gentle 0.6s ease;
    }

    @keyframes bounce-gentle {
        0%,
        100% {
            transform: translateY(0) scale(1);
        }
        50% {
            transform: translateY(-8px) scale(1.05);
        }
    }

    /* Filtro que convierte imágenes PNG negras al color #1F1F1F */
    .verde-filter {
        filter: brightness(0) saturate(100%) invert(18%) sepia(42%)
            saturate(525%) hue-rotate(115deg) brightness(78%) contrast(105%);
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP - CON HOJAS DECORATIVAS             -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initVestimenta = () => {
        console.log("👔 Iniciando sección de código de vestimenta...");

        // ═══ ESTADO INICIAL ═══
        gsap.set("#contenedor-vestimenta", {
            opacity: 0,
            y: 50,
            scale: 0.95,
        });

        // Flores laterales - Estado inicial
        gsap.set("#flor-vestimenta-left", {
            opacity: 0,
            x: -40,
            rotation: -8,
            scale: 0.9,
                    transformOrigin: "left center",
});

        gsap.set("#flor-vestimenta-right", {
            opacity: 0,
            x: 40,
            rotation: 8,
            scale: 0.9,
                    transformOrigin: "right center",
});

        // Hojas doradas - Estado inicial
        gsap.set("#hoja-vestimenta-left", {
            opacity: 0,
            scale: 0,
            rotation: -6,
            transformOrigin: "bottom center",
        });

        gsap.set("#hoja-vestimenta-right", {
            opacity: 0,
            scaleX: 0,
            scaleY: 0,
            rotation: 6,
            transformOrigin: "bottom center",
        });

        gsap.set("#tarjeta-vestimenta", { opacity: 0, y: 20 });

        // ═══ ANIMACIÓN PRINCIPAL ═══
        ScrollTrigger.create({
            trigger: "#contenedor-vestimenta",
            start: "top 75%",
            end: "top 20%",

            onEnter: () => {
                const tl = gsap.timeline();

                // Card aparece
                tl.to(
                    "#contenedor-vestimenta",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.6,
                        ease: "power3.out",
                    },
                    0,
                )

                    // 🌸 FLORES LATERALES - Entrada suave
                    .to(
                        "#flor-vestimenta-left",
                        {
                            opacity: 0.75,
                            x: 0,
                            rotation: -3,
                            scale: 1,
                            duration: 2.8,
                            ease: "sine.out",
                        },
                        0,
                    )

                    .to(
                        "#flor-vestimenta-right",
                        {
                            opacity: 0.75,
                            x: 0,
                            rotation: 3,
                            scale: 1,
                            duration: 2.8,
                            ease: "sine.out",
                        },
                        0.05,
                    )

                    // 🍃 HOJAS DORADAS - Crecimiento natural
                    .to(
                        "#hoja-vestimenta-left",
                        {
                            opacity: 0.7,
                            scale: 0.9,
                            rotation: -3,
                            duration: 2.2,
                            ease: "sine.out",
                        },
                        0.1,
                    )

                    .to(
                        "#hoja-vestimenta-right",
                        {
                            opacity: 0.7,
                            scale: 0.9,
                            rotation: 3,
                            duration: 2.2,
                            ease: "sine.out",
                        },
                        0.15,
                    )

                    // Contenido del card
                    .to(
                        "#tarjeta-vestimenta",
                        {
                            opacity: 1,
                            y: 0,
                            duration: 1,
                            ease: "power2.out",
                        },
                        0.8,
                    );

                // ═══════════════════════════════════════════════════
                // 🍃 MOVIMIENTOS MÁS NOTORIOS Y NATURALES
                // ═══════════════════════════════════════════════════

                // Flor izquierda - Movimiento más amplio

                // ═══ HOJAS DORADAS: balanceo visible ═══
                gsap.to("#hoja-vestimenta-left", {
                    y: -12,
                    rotation: -10,
                    duration: 4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3.5,
                });
                gsap.to("#hoja-vestimenta-right", {
                    y: -11,
                    rotation: 10,
                    scale: 0.85,
                    duration: 4.3,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3.7,
                });
                gsap.to("#hoja-vestimenta-left", {
                    scale: 0.85,
                    duration: 4.5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                    delay: 3.9,
                });

                // ═══ FLORES LATERALES: brisa natural ═══
                // Cada propiedad va en su propio tween con duraciones que no son
                // múltiplos entre sí (6.1 / 8.3 / 10.7 / 13.9): la combinación tarda
                // minutos en repetirse y se lee como movimiento vivo, no como bucle.
                // El giro parte del borde donde nace el ramo, no de su centro.
                const brisaNatural = (sel, dir, fase) => {
                    gsap.to(sel, {
                        rotation: 4 * dir,
                        duration: 6.1 + fase,
                        delay: 3.0 + fase * 0.6,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                    gsap.to(sel, {
                        y: -12,
                        duration: 8.3 + fase,
                        delay: 3.8 + fase * 0.5,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                    gsap.to(sel, {
                        x: 6 * dir,
                        duration: 10.7 + fase,
                        delay: 4.5 + fase * 0.4,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                    gsap.to(sel, {
                        scale: 1.05,
                        duration: 13.9 + fase,
                        delay: 5.2 + fase * 0.3,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                };

                brisaNatural("#flor-vestimenta-left", -1, 0);
                brisaNatural("#flor-vestimenta-right", 1, 0.9);
                // Flor derecha - Movimiento más amplio inverso

                // Hoja izquierda - Balanceo más pronunciado

                // Hoja derecha - Balanceo más pronunciado

                // ═══ RESPIRACIÓN MÁS VISIBLE ═══


                // ═══ MOVIMIENTO HORIZONTAL ADICIONAL (Efecto brisa) ═══

            },

            onLeaveBack: () => {
                // Resetear todas las animaciones continuas
                gsap.killTweensOf("#flor-vestimenta-left");
                gsap.killTweensOf("#flor-vestimenta-right");
                gsap.killTweensOf("#hoja-vestimenta-left");
                gsap.killTweensOf("#hoja-vestimenta-right");

                const tl = gsap.timeline();

                tl.to("#tarjeta-vestimenta", {
                    opacity: 0,
                    y: 20,
                    duration: 0.3,
                    ease: "power2.in",
                })

                    .to(
                        "#contenedor-vestimenta",
                        {
                            opacity: 0,
                            y: 50,
                            scale: 0.95,
                            duration: 0.5,
                            ease: "power2.in",
                        },
                        "<",
                    )

                    .to(
                        "#flor-vestimenta-left",
                        {
                            opacity: 0,
                            x: -40,
                            duration: 1,
                            ease: "sine.in",
                        },
                        "<",
                    )

                    .to(
                        "#flor-vestimenta-right",
                        {
                            opacity: 0,
                            x: 40,
                            duration: 1,
                            ease: "sine.in",
                        },
                        "<",
                    )

                    .to(
                        "#hoja-vestimenta-left, #hoja-vestimenta-right",
                        {
                            opacity: 0,
                            scale: 0,
                            duration: 0.8,
                            ease: "sine.in",
                        },
                        "<",
                    )

                    .set("#flor-vestimenta-left", {
                        rotation: -8,
                        scale: 0.9,
                        x: -40,
                        y: 0,
                    })
                    .set("#flor-vestimenta-right", {
                        rotation: 8,
                        scale: 0.9,
                        x: 40,
                        y: 0,
                    })
                    .set("#hoja-vestimenta-left", {
                        rotation: -6,
                        scale: 0,
                        y: 0,
                    })
                    .set("#hoja-vestimenta-right", {
                        scaleX: 0,
                        scaleY: 0,
                        rotation: 6,
                        y: 0,
                    });
            },
        });

        console.log(
            "👔✨ Sección de código de vestimenta con hojas vivas activada!",
        );
    };

    document.addEventListener("DOMContentLoaded", initVestimenta);
    document.addEventListener("astro:page-load", initVestimenta);
</script>
